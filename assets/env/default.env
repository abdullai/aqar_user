# Bundled defaults — do not put production secrets in this file if you commit changes.
# Set the anon key here for local runs, or use:
#   flutter run --dart-define=SUPABASE_ANON_KEY=eyJ...
# Or create a project root .env (see env.sample); optional second load merges it when present.
# COMPLIANCE_REGA_PUBLIC_URL=https://rega.gov.sa
# COMPLIANCE_NAFATH_PUBLIC_URL=https://www.nafath.sa
# COMPLIANCE_MC_BUSINESS_URL=https://mc.gov.sa
# COMPLIANCE_COMPLAINTS_EMAIL=compliance@yourdomain.sa
# COMPLIANCE_SUPPORT_EMAIL=support@yourdomain.sa
# COMPLIANCE_COMPLAINTS_WEB_URL=https://yourdomain.sa/complaints
# UAT/demo: keep government keys out of client builds; use synthetic data only.
# Either flag is read by PlatformComplianceConfig.governmentDemoMode() — same semantics.
# COMPLIANCE_DEMO_GOV_MODE=1
# GOVERNMENT_DEMO_MODE=1

# Moyasar (client: publishable key only). Webhook uses MOYASAR_SECRET_KEY on Supabase.
# MOYASAR_PUBLISHABLE_KEY=pk_test_...
# Without a Moyasar key, local mock/trial checkout is ON (debug + release).
# Disable trial mock explicitly: ALLOW_PAYMENT_MOCK=false
# With a Moyasar key, mock is off and live/test Moyasar is used.
# ALLOW_PAYMENT_MOCK=false
# MOYASAR_CALLBACK_URL=https://eaqar-mawthuq.web.app/moyasar-3ds-return
# MOYASAR_APPLE_PAY_MERCHANT_ID=merchant.sa.moyasar.<your-merchant-id>
#
# Edge function subscription-renew-cron (Supabase secrets, not in Flutter):
# SUBSCRIPTION_CRON_SECRET=long-random
# Optional metadata override for Moyasar:
# MOYASAR_METADATA_MERCHANT_CONTACT=Your legal name

SUPABASE_URL=https://czfvqhepsqkgsrfnknwm.supabase.co
SUPABASE_ANON_KEY=
