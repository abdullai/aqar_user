# Server-side configuration only. Do not commit credentials.
# Supabase Edge Function -> Saudi-hosted Nafath gateway
NAFATH_GATEWAY_URL=https://nafath-callback.onrender.com
NAFATH_GATEWAY_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
WATHQ_API_KEY=YOUR_WATHQ_API_KEY

# APP-ID, APP-KEY and NAFATH_SERVICE_PROVIDER_IP belong only on the Saudi host.
# Nafath verification does not create a Supabase Auth session by itself.
