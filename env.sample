# Copy this file to the project root as `.env` (optional merge on top of assets/env/default.env).
# On desktop `flutter run`, the app merges project-root `.env` automatically (no pubspec change).
# For web release, use web/supabase_config.json or --dart-define.
#
# Supabase → Project Settings → API Keys → Publishable (sb_publishable_…) أو anon JWT (eyJ…). لا تستخدم Secret في التطبيق.

SUPABASE_URL=https://czfvqhepsqkgsrfnknwm.supabase.co
SUPABASE_ANON_KEY=

# Moyasar — publishable key في العميل فقط (من لوحة ميسّر → مفاتيح الربط).
# للويب: انسخ web/supabase_config.json.example → web/supabase_config.json وأضف المفاتيح قبل build web.
# MOYASAR_PUBLISHABLE_KEY=pk_test_...   أو pk_live_...
# للاختبار ببطاقة وهمية: استخدم pk_test_ في العميل و sk_test_ في Supabase Secrets.
# بطاقة اختبار ميسّر: 4111 1111 1111 1111 — CVV 123 — تاريخ مستقبلي.
# بدون مفتاح ميسّر: الدفع التجريبي (mock) مفعّل افتراضياً (debug/release).
# لإيقاف التجربة صراحةً: ALLOW_PAYMENT_MOCK=false
# مع مفتاح ميسّر: يُلغى الـ mock تلقائياً ويُستخدم ميسّر (pk_test_ / pk_live_).
# ALLOW_PAYMENT_MOCK=false
# MOYASAR_CALLBACK_URL=https://eaqar-mawthuq.web.app/moyasar-3ds-return
# MOYASAR_APPLE_PAY_MERCHANT_ID=merchant.com.your.app
#
# Supabase Edge Functions (أسرار — ليست في Flutter):
#   MOYASAR_SECRET_KEY=sk_test_... أو sk_live_...
#   MOYASAR_WEBHOOK_SECRET=نفس «سر Webhook» عند إنشاء Webhook في لوحة ميسّر
#   URL: https://<project-ref>.supabase.co/functions/v1/moyasar-webhook

# --- Firebase Hosting (eaqar-mawthuq.web.app) ---
# firebase.json runs: flutter build web --release (no secrets in repo).
# Fix "SUPABASE_ANON_KEY is not set" on the live site:
#
#   A) Recommended: copy web/supabase_config.json.example → web/supabase_config.json
#      Fill SUPABASE_URL + SUPABASE_ANON_KEY, then deploy (file is copied next to index.html).
#      web/supabase_config.json is gitignored — do not commit real keys to a public repo.
#
#   B) Or add to the flutter build command (CI / local) before deploy:
#        flutter build web --release --dart-define=SUPABASE_ANON_KEY=eyJ...
